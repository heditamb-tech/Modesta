<Window x:Class="Modesta.Views.ClosetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Kledingkast" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mijn Kledingkast"
                   FontSize="22" FontFamily="Georgia"
                   Foreground="#5C4A32" FontStyle="Italic"
                   Margin="0,0,0,16"/>

        <!-- Collecties balk -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox x:Name="CollectionCombo" Width="200" Height="36"
                      Margin="0,0,12,0" SelectionChanged="CollectionCombo_Changed"/>
            <TextBox x:Name="NewCollectionBox" Width="160" Height="36"
                     Padding="10,8" Background="#F5EFE6"
                     BorderBrush="#E0D5C5" BorderThickness="1"
                     Margin="0,0,8,0"/>
            <Button Content="+ Collectie" Height="36" Padding="12,0"
                    Background="#F5EFE6" Foreground="#5C4A32"
                    BorderBrush="#E0D5C5" BorderThickness="1"
                    Cursor="Hand" Click="AddCollection_Click"
                    Margin="0,0,12,0"/>
            <Button Content="+ Item toevoegen" Height="36" Padding="12,0"
                    Background="#8B6F47" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="AddItem_Click"/>
        </StackPanel>

        <!-- Items grid -->
        <ScrollViewer Grid.Row="2">
            <WrapPanel x:Name="ItemsPanel"/>
        </ScrollViewer>
    </Grid>
</Window>