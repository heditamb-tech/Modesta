<Window x:Class="Modesta.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Zoeken" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Zoeken" FontSize="22"
                   FontFamily="Georgia" Foreground="#5C4A32"
                   FontStyle="Italic" Margin="24,16,24,12"/>

        <Grid Grid.Row="1" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="44" Padding="12,8"
                     Background="#F5EFE6" BorderBrush="#E0D5C5"
                     BorderThickness="1" FontSize="13"
                     Grid.Column="0" Margin="0,0,8,0"/>
            <Button Content="Zoeken" Height="44" Padding="16,0"
                    Background="#8B6F47" Foreground="White"
                    BorderThickness="0" FontSize="13"
                    Cursor="Hand" Click="Search_Click"
                    Grid.Column="1"/>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="ResultsPanel" Margin="24,0,24,24"/>
        </ScrollViewer>
    </Grid>
</Window>