<Window x:Class="Modesta.Views.PostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Post plaatsen" Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <ScrollViewer>
        <Grid Margin="30">
            <StackPanel>
                <TextBlock Text="Outfit posten" FontSize="22" FontFamily="Georgia"
                           Foreground="#5C4A32" FontStyle="Italic" Margin="0,0,0,20"/>

                <Border x:Name="PhotoBorder" Height="200" Background="#F5EFE6"
                        BorderBrush="#C4A882" BorderThickness="2"
                        CornerRadius="8" Margin="0,0,0,16" Cursor="Hand"
                        MouseLeftButtonUp="PhotoBorder_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Klik om foto te uploaden"
                                   FontSize="13" Foreground="#8B6F47"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Image x:Name="PreviewImage" Height="200" Stretch="UniformToFill"
                       Margin="0,0,0,16" Visibility="Collapsed"/>

                <TextBlock Text="Caption" Foreground="#7A6B5A" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="CaptionBox" Height="80" Padding="10,8"
                         Background="#F5EFE6" BorderBrush="#E0D5C5"
                         BorderThickness="1" TextWrapping="Wrap"
                         AcceptsReturn="True" Margin="0,0,0,16"/>

                <TextBlock Text="Items taggen (verplicht)" FontWeight="Medium"
                           Foreground="#3A2E22" FontSize="13" Margin="0,0,0,8"/>

                <ItemsControl x:Name="TagsList" Margin="0,0,0,8"/>

                <Button Content="+ Item toevoegen" Height="40" Padding="12,0"
                        Background="#F5EFE6" Foreground="#5C4A32"
                        BorderBrush="#E0D5C5" BorderThickness="1"
                        Cursor="Hand" Click="AddTag_Click" Margin="0,0,0,16"/>

                <Button Content="Publiceren" Height="42"
                        Background="#8B6F47" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Click="Publish_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>