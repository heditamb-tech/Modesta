<Window x:Class="Modesta.Views.FeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Feed" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Feed" FontSize="22" FontFamily="Georgia"
                   Foreground="#5C4A32" FontStyle="Italic" Margin="24,16,0,12"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="FeedPanel" Margin="24,0,24,24"/>
        </ScrollViewer>
    </Grid>
</Window>