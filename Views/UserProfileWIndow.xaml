<Window x:Class="Modesta.Views.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Profiel" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FDFAF6"
                BorderBrush="#E0D5C5" BorderThickness="0,0,0,1"
                Padding="24,20,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80"
                        CornerRadius="40" ClipToBounds="True"
                        Background="#C4A882" Margin="0,0,16,0">
                    <Image x:Name="ProfilePic" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UsernameText" FontSize="18"
                               FontWeight="Medium" Foreground="#3A2E22"/>
                    <TextBlock x:Name="BioText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,4,0,0"/>
                    <TextBlock x:Name="PostCountText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,8,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Rapporteer"
                        Height="40" Padding="16,0"
                        Background="Transparent" Foreground="#C0392B"
                        BorderBrush="#C0392B" BorderThickness="1"
                        FontSize="13" Cursor="Hand"
                        Click="ReportUser_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="PostsPanel" Margin="24"/>
        </ScrollViewer>
    </Grid>
</Window>