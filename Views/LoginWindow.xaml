<Window x:Class="Modesta.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta" Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="281*"/>
            <ColumnDefinition Width="139*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#FDFAF6" BorderBrush="#E0D5C5" BorderThickness="1"
                CornerRadius="16" Padding="36" Width="360"
                VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="30,0,0,0">
            <StackPanel>
                <TextBlock Text="Modesta" FontSize="28" FontFamily="Georgia"
                           Foreground="#5C4A32" HorizontalAlignment="Center"
                           FontStyle="Italic" Margin="0,0,0,4"/>
                <TextBlock Text="Your modesty. Your choice." FontSize="12"
                           Foreground="#7A6B5A" HorizontalAlignment="Center"
                           FontStyle="Italic" Margin="0,0,0,28"/>

                <TextBlock Text="E-mailadres" Foreground="#7A6B5A" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Height="40" Padding="10,8"
                         Background="#F5EFE6" BorderBrush="#E0D5C5"
                         BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="Wachtwoord" Foreground="#7A6B5A" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="40" Padding="10,8"
                             Background="#F5EFE6" BorderBrush="#E0D5C5"
                             BorderThickness="1" Margin="0,0,0,20"/>

                <Button x:Name="LoginBtn" Content="Inloggen" Height="42"
                        Background="#8B6F47" Foreground="White"
                        BorderThickness="0" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Click="LoginBtn_Click" Margin="0,0,0,8"/>

                <Button x:Name="RegisterBtn" Content="Nog geen account? Registreer"
                        Height="42" Background="Transparent" Foreground="#8B6F47"
                        BorderBrush="#8B6F47" BorderThickness="1" FontSize="13"
                        Cursor="Hand" Click="RegisterBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>