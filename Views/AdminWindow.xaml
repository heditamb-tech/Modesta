<Window x:Class="Modesta.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modesta — Admin" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FDFAF6"
                BorderBrush="#E0D5C5" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="Admin" FontSize="18" FontFamily="Georgia"
                           Foreground="#5C4A32" FontStyle="Italic"
                           Margin="0,16,0,24"/>
                <Button Content="Gebruikers" Height="44" Margin="0,0,0,4"
                        Background="#F5EFE6" Foreground="#5C4A32"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="12,0" Cursor="Hand" Click="Users_Click"/>
                <Button Content="Rapporten" Height="44" Margin="0,0,0,4"
                        Background="Transparent" Foreground="#7A6B5A"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="12,0" Cursor="Hand" Click="Reports_Click"/>
                <Button Content="Statistieken" Height="44"
                        Background="Transparent" Foreground="#7A6B5A"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="12,0" Cursor="Hand" Click="Stats_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="ContentPanel" Margin="24"/>
        </ScrollViewer>
    </Grid>
</Window>