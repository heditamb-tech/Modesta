<Window x:Class="Modesta.Views.TagInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item info" Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid Margin="28">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontFamily="Georgia"
                       Foreground="#5C4A32" FontStyle="Italic" Margin="0,0,0,16"/>

            <Border Background="#FDFAF6" BorderBrush="#E0D5C5"
                    BorderThickness="1" CornerRadius="10" Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TypeText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,0,0,6"/>
                    <TextBlock x:Name="BrandText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ShopText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,0,0,6"/>
                    <TextBlock x:Name="AddressText" FontSize="12"
                               Foreground="#7A6B5A" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LinkText" FontSize="12"
                               Foreground="#8B6F47" TextDecorations="Underline"
                               Cursor="Hand" Margin="0,0,0,0"
                               MouseLeftButtonUp="Link_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Opslaan in collectie:" Foreground="#7A6B5A"
                       FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="CollectionCombo" Height="40"
                      Background="#F5EFE6" BorderBrush="#E0D5C5"
                      BorderThickness="1" Margin="0,0,0,12"/>

            <Button x:Name="SaveBtn" Content="Opslaan in kledingkast" Height="42"
                    Background="#8B6F47" Foreground="White"
                    BorderThickness="0" FontSize="13"
                    Cursor="Hand" Click="Save_Click" Margin="0,0,0,8"/>

            <Button Content="Sluiten" Height="42"
                    Background="Transparent" Foreground="#8B6F47"
                    BorderBrush="#8B6F47" BorderThickness="1" FontSize="13"
                    Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>